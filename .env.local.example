# ============================================================
# Miljövariabler (mall)
# Kopiera denna fil till .env.local och fyll i dina värden
# ============================================================

# ---- Supabase ----
# Hitta dessa i: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://ditt-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=din_publishable_nyckel_här
# Secret key (sb_secret_...) – används bara på servern för admin-åtgärder.
# Får ALDRIG exponeras mot klienten eller checkas in i git.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_din_hemliga_nyckel_här

# ---- Resend (e-post) ----
# Skapa API-nyckel på: resend.com/api-keys
RESEND_API_KEY=re_din_api_nyckel_här
# Avsändaradress – domänen måste vara verifierad i Resend
RESEND_FROM=Ditt Varumärke <noreply@dindoman.se>

# ---- Webbplats URL ----
# Används för länkar i e-post och för auth-redirects.
# Lokalt: http://localhost:3000
# Produktion: https://www.dindoman.se
NEXT_PUBLIC_SITE_URL=http://localhost:3000
